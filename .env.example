# Copy to .env and fill in (auto-loaded by config.py; never overrides existing env vars)

# ---- oMLX LLM ----
OMLX_BASE_URL=http://localhost:8000/v1
OMLX_API_KEY=oMLX_APIKey
LLM_MODEL=Qwen3.8-Flash-Next-oQ4e-mtp

# ---- oMLX audio models (see GET /v1/models for ids) ----
TTS_MODEL_ID=Qwen3-TTS-12Hz-1.7B-Base-fp32
ASR_MODEL_ID=Qwen3-ASR-1.7B-bf16

# Base TTS requires a reference audio for voice cloning (fixed voice)
# Values containing apostrophes MUST be wrapped in single quotes, or `source .env` fails to parse
REF_AUDIO_PATH=/path/to/your/reference.wav
REF_TEXT='verbatim transcript of the reference audio'

# ---- Per-language reference audio (avoid cross-language accent contamination: use the ref matching the synthesized language) ----
# Languages left unset fall back to REF_AUDIO_PATH/REF_TEXT above
REF_AUDIO_PATH_JA=/path/to/ref_ja.wav
REF_TEXT_JA='verbatim transcript of the Japanese reference audio'
REF_AUDIO_PATH_ZH=/path/to/ref_zh.wav
REF_TEXT_ZH='verbatim transcript of the Chinese reference audio'
REF_AUDIO_PATH_EN=/path/to/ref_en.wav
REF_TEXT_EN='verbatim transcript of the English reference audio'

# ---- TTS speed multiplier (1.0 = normal, >1 faster, recommended 1.0-1.3) ----
TTS_SPEED=1.15

# ---- ASR ----
# ASR_LANGUAGE: auto = language detection (ja/zh/en mixed OK), or pin ja/zh/en
ASR_LANGUAGE=auto
# Recognition biasing vocabulary: noun phrases only, never instructional sentences (ASR would transcribe them as speech)
ASR_PROMPT='domain nouns phrase examples'

# ---- Behavior tuning ----
BARGE_IN_MS=400
TURN_END_SILENCE_SEC=0.8
PORT=8765
